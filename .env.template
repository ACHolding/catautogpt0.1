# Copy this file to `.env` and fill in real values:
#   cp .env.template .env
# Or run: ./scripts/setup_catseek.sh

################################################################################
### CATAUTOGPT - LOCAL CATSEEK-GPU 0.1 (DeepSeek-R1-Distill-Qwen-14B)
################################################################################

## Real llama.cpp GGUF (~8–9GB Q4_K_M). Auto-downloads on first run.
##   ./scripts/setup_catseek.sh   # bake + vibe-train → auto_gpt_workspace/
CATSEEK_MODEL_PATH=
CATSEEK_AUTO_DOWNLOAD=True
# CATSEEK_HF_REPO=bartowski/DeepSeek-R1-Distill-Qwen-14B-GGUF
# CATSEEK_HF_FILE=DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf
# CATSEEK_MODEL_DIR=models/CatSeek-GPU-0.1-14B

## Runtime (Metal offload on Apple Silicon by default)
CATSEEK_N_CTX=8192
CATSEEK_N_BATCH=512
CATSEEK_N_THREADS=8
CATSEEK_N_GPU_LAYERS=-1
CATSEEK_STRIP_THINK=True
# CATSEEK_CHAT_FORMAT=chatml
# CATSEEK_VERBOSE=False
# CATSEEK_EMBED_DIMS=1536

## Legacy BitNet aliases (optional — CatSeek writes both into .env on bake)
# BITNET_MODEL_PATH=
# BITNET_AUTO_DOWNLOAD=False
# BITNET_AUTO_BUILD=False

################################################################################
### MODELS (aliases map to CatSeek-GPU 0.1)
################################################################################

FAST_LLM=catseek-gpu-0.1
SMART_LLM=catseek-gpu-0.1
EMBEDDING_MODEL=catseek-embed
# TEMPERATURE=0

################################################################################
### RUNTIME
################################################################################

# EXECUTE_LOCAL_COMMANDS=False
# RESTRICT_TO_WORKSPACE=True
# PLAIN_OUTPUT=False

