# Copy this file to `.env` and fill in real values:
#   cp .env.template .env
# Or run: ./scripts/setup_bitnet.sh

################################################################################
### CATAUTOGPT - LOCAL BITNET LLM (no OpenAI API)
################################################################################

## Official BitNet b1.58 chat GGUF (i2_s preferred)
## Auto-downloads on first run when missing (BITNET_AUTO_DOWNLOAD=True).
##   ./scripts/setup_bitnet.sh   # or just ./run.sh
BITNET_MODEL_PATH=
BITNET_AUTO_DOWNLOAD=True
# BITNET_HF_REPO=microsoft/BitNet-b1.58-2B-4T-gguf
# BITNET_MODEL_DIR=models/BitNet-b1.58-2B-4T

## Optional BitNet embedding GGUF (BitNet-embedding-0.6B / 270M)
# BITNET_EMBED_MODEL_PATH=

## Backend: auto | bitnet.cpp | llama-cpp
## Official i2_s GGUF REQUIRES bitnet.cpp (stock llama-cpp-python cannot load it).
## BITNET_AUTO_BUILD=True clones/builds microsoft/BitNet (uses ~/.cache when the
## project path contains '#' or ':', which breaks Make on this USB volume).
BITNET_AUTO_BUILD=True
# BITNET_BACKEND=bitnet.cpp
# BITNET_HOME=/Users/YOU/.cache/catautogpt/BitNet
# BITNET_CLI=/Users/YOU/.cache/catautogpt/BitNet/build/bin/llama-cli

## Tuned llama.cpp / bitnet.cpp runtime
# BITNET_N_CTX=4096
# BITNET_N_BATCH=512
# BITNET_N_UBATCH=512
# BITNET_N_THREADS=8
# BITNET_N_THREADS_BATCH=8
# BITNET_N_GPU_LAYERS=0
# BITNET_USE_MMAP=True
# BITNET_USE_MLOCK=False
# BITNET_FLASH_ATTN=False
# BITNET_CHAT_FORMAT=llama-3
# BITNET_SEED=-1
# BITNET_VERBOSE=False
# BITNET_EMBED_DIMS=1024

################################################################################
### MODELS (aliases map to BitNet)
################################################################################

FAST_LLM=bitnet-b1.58
SMART_LLM=bitnet-b1.58
EMBEDDING_MODEL=bitnet-embed
# TEMPERATURE=0

################################################################################
### RUNTIME
################################################################################

# EXECUTE_LOCAL_COMMANDS=False
# RESTRICT_TO_WORKSPACE=True
# PLAIN_OUTPUT=False

## Image generation (OpenAI DALL-E removed)
# IMAGE_PROVIDER=huggingface
# HUGGINGFACE_API_TOKEN=
