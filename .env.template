# Copy this file to `.env` and fill in real values:
#   cp .env.template .env

################################################################################
### CATAUTOGPT - LOCAL BITNET LLM (no OpenAI API)
################################################################################

## BITNET_MODEL_PATH - Path to a BitNet (or compatible) GGUF model file
## Example download:
##   huggingface-cli download microsoft/BitNet-b1.58-2B-4T-gguf \
##     --local-dir models/BitNet-b1.58-2B-4T
##   BITNET_MODEL_PATH=models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf
BITNET_MODEL_PATH=

## Optional llama.cpp tuning
# BITNET_N_CTX=4096
# BITNET_N_THREADS=8
# BITNET_VERBOSE=False

################################################################################
### MODELS (aliases map to BitNet)
################################################################################

FAST_LLM=bitnet-b1.58
SMART_LLM=bitnet-b1.58
EMBEDDING_MODEL=bitnet-embed
# TEMPERATURE=0

################################################################################
### RUNTIME
################################################################################

# EXECUTE_LOCAL_COMMANDS=False
# RESTRICT_TO_WORKSPACE=True
# PLAIN_OUTPUT=False

## Image generation (OpenAI DALL-E removed)
# IMAGE_PROVIDER=huggingface
# HUGGINGFACE_API_TOKEN=
